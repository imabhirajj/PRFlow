# ========================================================
# PRFlow Backend Environment Variables
# ========================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/prflow

# JWT Secret for signing authentication tokens
JWT_SECRET=your_long_random_jwt_secret_key

# Frontend Client URL (Used for CORS and OAuth redirects)
# For local dev: http://localhost:5173
# For production: https://prflow.vercel.app
CLIENT_URL=http://localhost:5173

# GitHub OAuth 2.0 Credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub OAuth Callback URL:
# For local dev: http://localhost:5000/api/auth/github/callback
# For production: https://prflow-backend.onrender.com/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
